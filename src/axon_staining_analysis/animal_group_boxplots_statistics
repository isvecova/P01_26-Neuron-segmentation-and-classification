#!/usr/bin/env python3
"""
ANIMAL-LEVEL GROUP SUMMARY, STATISTICS, AND BOXPLOTS

This script reads:
    all_images_sample_summary.csv

It:
1. Extracts animal_id as everything before the first underscore.
2. Excludes any animal whose animal_id matches an entry in
   EXCLUDE_ANIMAL_ID_TOKENS (e.g. "NC" negative-control animals) before any
   group parsing or statistics happen.
3. Detects one of these groups anywhere in the filename:
       WT+PLA
       WT+Cykla
       P301S+Cykla
       P301S+PLA
4. Averages all samples/images belonging to the same animal.
5. Uses the ANIMAL, not the image or cell, as the independent experimental unit.
6. Produces one boxplot per metric with individual animal points, each
   labeled with its animal_id.
7. Runs:
       - overall Kruskal-Wallis test across the four groups
       - pairwise two-sided Mann-Whitney U tests
       - Holm correction across all six pairwise comparisons
8. Writes animal-level values and statistics to CSV files.

Install:
    pip install numpy pandas scipy matplotlib

Run:
    Edit SETTINGS below and run from the IDE/editor.
"""

from __future__ import annotations

import re
from itertools import combinations
from pathlib import Path
from typing import Dict, List

import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from scipy import stats


# ============================================================
# SETTINGS
# ============================================================

INPUT_CSV = Path(
    r"N:\Sarah\Croatia project\DAPI, 488 NeuN, 594 Synaptophysin, 647 PSD95\puncta_analysis_output_updated_1\all_images_sample_summary.csv"
)
OUTPUT_ROOT = Path(
    r"N:\Sarah\Croatia project\DAPI, 488 NeuN, 594 Synaptophysin, 647 PSD95\puncta_analysis_output_updated_1\animal_group_statistics"
)

GROUP_ORDER = [
    "WT+PLA",
    "WT+Cykla",
    "P301S+PLA",
    "P301S+Cykla",
]

# Brain regions to detect and analyze separately -- mixing regions together
# wouldn't be a meaningful comparison, so the whole statistics/plotting
# pipeline below runs once per region.
REGION_TOKENS = {
    "MC": "Motor cortex",
    "HC": "Hippocampus",
}

# Animal IDs matching any of these tokens (case-insensitive substring match
# against animal_id, e.g. an id like "NC1" or "NC03") are dropped entirely
# before group parsing or statistics -- e.g. negative-control animals that
# aren't part of the four experimental groups above.
EXCLUDE_ANIMAL_ID_TOKENS = ["NC"]

# Metrics to analyze. Remove or add columns as needed.
METRICS = [
    "mean_synaptophysin_count_per_neun",
    "mean_psd95_count_per_neun",
    "mean_colocalized_pairs_per_neun",
    "mean_synaptophysin_density_per_100_um3",
    "mean_psd95_density_per_100_um3",
    "mean_colocalized_density_per_100_um3",
    "mean_fraction_synaptophysin_paired",
    "mean_fraction_psd95_paired",
]

# Plot settings.
FIGURE_WIDTH = 7
FIGURE_HEIGHT = 6
DPI = 200
SHOW_ALL_PAIRWISE_P_VALUES = False
ANNOTATE_SIGNIFICANT_ONLY = True
ALPHA = 0.05

# Animal-ID point labels.
ANNOTATE_POINTS_WITH_ANIMAL_ID = True
POINT_LABEL_FONTSIZE = 6
POINT_LABEL_OFFSET_POINTS = (4, 2)  # (x, y) offset in points from the marker

# Reproducible horizontal jitter for individual animal points.
RANDOM_SEED = 12345


# ============================================================
# HELPERS
# ============================================================

def parse_group(file_name: str) -> str:
    """
    Detect group names anywhere in the filename.

    Matching longer/more specific names first prevents accidental ambiguity.
    """
    normalized = file_name.lower()

    lookup = {
        "WT+PLA": ["wt+pla", "wt_pla", "wt-pla"],
        "WT+Cykla": ["wt+cykla", "wt_cykla", "wt-cykla"],
        "P301S+PLA": ["p301s+pla", "p301s_pla", "p301s-pla"],
        "P301S+Cykla": ["p301s+cykla", "p301s_cykla", "p301s-cykla"],
    }

    matches = []
    for group, variants in lookup.items():
        if any(v in normalized for v in variants):
            matches.append(group)

    if len(matches) == 0:
        raise ValueError(f"No recognized group found in filename: {file_name}")
    if len(matches) > 1:
        raise ValueError(f"Multiple groups found in filename: {file_name}: {matches}")

    return matches[0]


def parse_region(file_name: str) -> str:
    """
    Detect the brain region (a REGION_TOKENS key, e.g. "MC" or "HC") from
    the filename.

    Unlike parse_group (substring matching), this splits the filename into
    whole tokens on any non-alphanumeric character and requires an EXACT
    (case-insensitive) match -- "MC" is short enough that substring matching
    could accidentally hit inside an unrelated word, whereas as a standalone
    token (e.g. "..._P301S+Cykla_MC_Synapto+PSD95_...") it's unambiguous.
    """
    tokens = re.split(r"[^A-Za-z0-9]+", file_name)
    tokens_upper = {t.upper() for t in tokens if t}

    matches = [region for region in REGION_TOKENS if region in tokens_upper]

    if len(matches) == 0:
        raise ValueError(
            f"No recognized region token ({list(REGION_TOKENS)}) found as a "
            f"standalone token in filename: {file_name}"
        )
    if len(matches) > 1:
        raise ValueError(f"Multiple region tokens found in filename: {file_name}: {matches}")

    return matches[0]


def holm_adjust(p_values: List[float]) -> List[float]:
    """
    Holm step-down family-wise error correction.
    """
    p = np.asarray(p_values, dtype=float)
    n = len(p)

    order = np.argsort(p)
    sorted_p = p[order]
    adjusted_sorted = np.empty(n, dtype=float)

    running_max = 0.0
    for rank, value in enumerate(sorted_p):
        adjusted = (n - rank) * value
        running_max = max(running_max, adjusted)
        adjusted_sorted[rank] = min(running_max, 1.0)

    adjusted = np.empty(n, dtype=float)
    adjusted[order] = adjusted_sorted
    return adjusted.tolist()


def p_to_stars(p: float) -> str:
    if not np.isfinite(p):
        return "n/a"
    if p < 0.0001:
        return "****"
    if p < 0.001:
        return "***"
    if p < 0.01:
        return "**"
    if p < 0.05:
        return "*"
    return "ns"


def prepare_animal_level_data(df: pd.DataFrame) -> pd.DataFrame:
    if "file_name" not in df.columns:
        raise ValueError("Input CSV must contain a 'file_name' column.")

    df = df.copy()
    df["animal_id"] = df["file_name"].astype(str).str.split("_", n=1).str[0]

    # Drop excluded animals (e.g. negative controls) BEFORE group parsing,
    # since their filenames may not contain any of the four group tokens
    # and would otherwise make parse_group raise.
    if EXCLUDE_ANIMAL_ID_TOKENS:
        tokens_upper = [token.upper() for token in EXCLUDE_ANIMAL_ID_TOKENS]
        exclude_mask = df["animal_id"].str.upper().apply(
            lambda aid: any(token in aid for token in tokens_upper)
        )
        excluded_ids = sorted(df.loc[exclude_mask, "animal_id"].unique())
        if excluded_ids:
            print(
                f"Excluding {int(exclude_mask.sum())} row(s) for animal_id(s) "
                f"matching {EXCLUDE_ANIMAL_ID_TOKENS}: {excluded_ids}"
            )
        df = df.loc[~exclude_mask].reset_index(drop=True)

    if df.empty:
        raise ValueError(
            "No rows remain after applying EXCLUDE_ANIMAL_ID_TOKENS -- check the "
            "exclusion list against your actual animal_id values."
        )

    df["group"] = df["file_name"].astype(str).apply(parse_group)
    df["region"] = df["file_name"].astype(str).apply(parse_region)

    # Verify that every animal belongs to only one group.
    group_count = df.groupby("animal_id")["group"].nunique()
    invalid = group_count[group_count > 1]
    if not invalid.empty:
        raise ValueError(
            "The following animal IDs occur in more than one group: "
            + ", ".join(invalid.index.astype(str))
        )

    available_metrics = [metric for metric in METRICS if metric in df.columns]
    missing_metrics = [metric for metric in METRICS if metric not in df.columns]

    if missing_metrics:
        print("Warning: these requested metrics are absent and will be skipped:")
        for metric in missing_metrics:
            print(f"  - {metric}")

    if not available_metrics:
        raise ValueError("None of the requested METRICS exist in the input CSV.")

    # Each animal contributes one value per metric PER REGION: mean across
    # that animal's images/samples for that region. An animal with both MC
    # and HC images ends up with two separate rows here (one per region).
    animal = (
        df.groupby(["animal_id", "group", "region"], as_index=False)[available_metrics]
        .mean(numeric_only=True)
    )
    return animal


def run_statistics(animal: pd.DataFrame, metric: str):
    groups = {}
    for group in GROUP_ORDER:
        values = animal.loc[animal["group"] == group, metric].dropna().to_numpy(dtype=float)
        groups[group] = values

    nonempty = [values for values in groups.values() if len(values) > 0]

    if len(nonempty) >= 2:
        try:
            kw = stats.kruskal(*nonempty, nan_policy="omit")
            kw_h = float(kw.statistic)
            kw_p = float(kw.pvalue)
        except ValueError:
            kw_h = np.nan
            kw_p = np.nan
    else:
        kw_h = np.nan
        kw_p = np.nan

    pairwise_rows = []
    raw_p = []

    for group_a, group_b in combinations(GROUP_ORDER, 2):
        a = groups[group_a]
        b = groups[group_b]

        if len(a) > 0 and len(b) > 0:
            result = stats.mannwhitneyu(a, b, alternative="two-sided", method="auto")
            u = float(result.statistic)
            p = float(result.pvalue)
        else:
            u = np.nan
            p = np.nan

        pairwise_rows.append({
            "metric": metric,
            "group_a": group_a,
            "group_b": group_b,
            "n_a": len(a),
            "n_b": len(b),
            "mann_whitney_u": u,
            "p_raw": p,
        })
        raw_p.append(p)

    finite_indices = [i for i, p in enumerate(raw_p) if np.isfinite(p)]
    finite_adjusted = holm_adjust([raw_p[i] for i in finite_indices])

    adjusted = [np.nan] * len(raw_p)
    for index, value in zip(finite_indices, finite_adjusted):
        adjusted[index] = value

    for row, p_adj in zip(pairwise_rows, adjusted):
        row["p_holm"] = p_adj
        row["significance"] = p_to_stars(p_adj)

    overall_row = {
        "metric": metric,
        "test": "Kruskal-Wallis",
        "number_of_groups_with_data": len(nonempty),
        "H_statistic": kw_h,
        "p_value": kw_p,
        "significance": p_to_stars(kw_p),
    }

    return groups, overall_row, pairwise_rows


def add_significance_annotations(
    ax,
    pairwise: pd.DataFrame,
    group_positions: Dict[str, int],
    y_values: np.ndarray,
) -> None:
    rows = pairwise.copy()

    if ANNOTATE_SIGNIFICANT_ONLY:
        rows = rows[rows["p_holm"] < ALPHA]
    elif not SHOW_ALL_PAIRWISE_P_VALUES:
        return

    rows = rows[np.isfinite(rows["p_holm"])]
    if rows.empty:
        return

    finite_y = y_values[np.isfinite(y_values)]
    if finite_y.size == 0:
        return

    y_min = float(np.min(finite_y))
    y_max = float(np.max(finite_y))
    span = y_max - y_min
    if span == 0:
        span = max(abs(y_max), 1.0)

    base = y_max + 0.10 * span
    step = 0.10 * span

    for level, (_, row) in enumerate(rows.iterrows()):
        x1 = group_positions[row["group_a"]]
        x2 = group_positions[row["group_b"]]
        y = base + level * step
        h = 0.025 * span

        ax.plot([x1, x1, x2, x2], [y, y + h, y + h, y], linewidth=1)
        label = (
            row["significance"]
            if ANNOTATE_SIGNIFICANT_ONLY
            else f"p={row['p_holm']:.3g}"
        )
        ax.text((x1 + x2) / 2, y + h, label, ha="center", va="bottom", fontsize=9)

    ax.set_ylim(top=base + (len(rows) + 1) * step)


def make_boxplot(
    animal: pd.DataFrame,
    metric: str,
    overall_row: Dict,
    pairwise_rows: List[Dict],
    output_path: Path,
    title_suffix: str = "",
) -> None:
    rng = np.random.default_rng(RANDOM_SEED)

    # Keep animal_id alongside each value so points can be labeled.
    group_frames = [
        animal.loc[animal["group"] == group, ["animal_id", metric]].dropna(subset=[metric])
        for group in GROUP_ORDER
    ]
    data = [gf[metric].to_numpy(dtype=float) for gf in group_frames]

    fig, ax = plt.subplots(figsize=(FIGURE_WIDTH, FIGURE_HEIGHT))

    ax.boxplot(
        data,
        positions=np.arange(1, len(GROUP_ORDER) + 1),
        widths=0.55,
        patch_artist=False,
        showfliers=False,
        medianprops={"linewidth": 1.5},
    )

    all_y = []

    for position, (group, gf) in enumerate(zip(GROUP_ORDER, group_frames), start=1):
        values = gf[metric].to_numpy(dtype=float)
        if len(values) == 0:
            continue

        jitter = rng.normal(loc=0.0, scale=0.055, size=len(values))
        x = np.full(len(values), position) + jitter
        ax.scatter(
            x,
            values,
            s=35,
            alpha=0.85,
            zorder=3,
        )
        all_y.extend(values.tolist())

        if ANNOTATE_POINTS_WITH_ANIMAL_ID:
            for xi, yi, animal_id in zip(x, values, gf["animal_id"]):
                ax.annotate(
                    str(animal_id),
                    (xi, yi),
                    textcoords="offset points",
                    xytext=POINT_LABEL_OFFSET_POINTS,
                    fontsize=POINT_LABEL_FONTSIZE,
                    alpha=0.8,
                )

        # Show n directly under each group.
        ax.text(
            position,
            0.01,
            f"n={len(values)}",
            transform=ax.get_xaxis_transform(),
            ha="center",
            va="bottom",
            fontsize=8,
        )

    ax.set_xticks(np.arange(1, len(GROUP_ORDER) + 1))
    ax.set_xticklabels(GROUP_ORDER, rotation=20, ha="right")
    ax.set_ylabel(metric.replace("_", " "))
    ax.set_title(
        f"{metric.replace('_', ' ')}{title_suffix}\n"
        f"Kruskal-Wallis p={overall_row['p_value']:.3g}"
        if np.isfinite(overall_row["p_value"])
        else f"{metric.replace('_', ' ')}{title_suffix}\nKruskal-Wallis unavailable"
    )

    pairwise_df = pd.DataFrame(pairwise_rows)
    positions = {group: index for index, group in enumerate(GROUP_ORDER, start=1)}
    add_significance_annotations(
        ax,
        pairwise_df,
        positions,
        np.asarray(all_y, dtype=float),
    )

    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)
    fig.tight_layout()
    fig.savefig(output_path, dpi=DPI, bbox_inches="tight")
    plt.close(fig)


def main() -> None:
    if not INPUT_CSV.exists():
        raise FileNotFoundError(f"INPUT_CSV does not exist: {INPUT_CSV}")

    OUTPUT_ROOT.mkdir(parents=True, exist_ok=True)

    sample = pd.read_csv(INPUT_CSV)
    animal_all_regions = prepare_animal_level_data(sample)
    animal_all_regions.to_csv(OUTPUT_ROOT / "animal_level_means_all_regions.csv", index=False)

    regions_present = [r for r in REGION_TOKENS if r in animal_all_regions["region"].unique()]
    if not regions_present:
        raise ValueError(
            f"None of the expected region tokens {list(REGION_TOKENS)} were found "
            "in the data after parsing."
        )

    for region in regions_present:
        region_label = REGION_TOKENS[region]
        print(f"\n=== Region: {region} ({region_label}) ===")

        region_root = OUTPUT_ROOT / region
        region_root.mkdir(parents=True, exist_ok=True)

        animal = animal_all_regions.loc[animal_all_regions["region"] == region].reset_index(drop=True)
        animal.to_csv(region_root / "animal_level_means.csv", index=False)

        metrics = [metric for metric in METRICS if metric in animal.columns]

        overall_rows = []
        pairwise_rows_all = []

        for metric in metrics:
            _, overall_row, pairwise_rows = run_statistics(animal, metric)
            overall_row["region"] = region
            overall_rows.append(overall_row)
            for row in pairwise_rows:
                row["region"] = region
            pairwise_rows_all.extend(pairwise_rows)

            make_boxplot(
                animal,
                metric,
                overall_row,
                pairwise_rows,
                region_root / f"{metric}_boxplot.png",
                title_suffix=f" -- {region_label}",
            )

        pd.DataFrame(overall_rows).to_csv(
            region_root / "overall_kruskal_wallis.csv",
            index=False,
        )
        pd.DataFrame(pairwise_rows_all).to_csv(
            region_root / "pairwise_mann_whitney_holm.csv",
            index=False,
        )

        group_summary_rows = []
        for metric in metrics:
            for group in GROUP_ORDER:
                values = animal.loc[animal["group"] == group, metric].dropna()
                group_summary_rows.append({
                    "metric": metric,
                    "group": group,
                    "region": region,
                    "n_animals": int(values.shape[0]),
                    "mean": float(values.mean()) if len(values) else np.nan,
                    "sd": float(values.std(ddof=1)) if len(values) > 1 else np.nan,
                    "median": float(values.median()) if len(values) else np.nan,
                    "q1": float(values.quantile(0.25)) if len(values) else np.nan,
                    "q3": float(values.quantile(0.75)) if len(values) else np.nan,
                })

        pd.DataFrame(group_summary_rows).to_csv(
            region_root / "group_descriptive_statistics.csv",
            index=False,
        )

        print(f"  Saved region results to: {region_root}")

    print(f"\nAll animal-level data and plots saved under: {OUTPUT_ROOT}")


if __name__ == "__main__":
    main()