#!/usr/bin/env python3
"""
FOLLOW-UP ANALYSIS:
Count Synaptophysin and PSD95 puncta around already segmented NeuN-positive cells.

Channel order in the .ims files:
    0 = DAPI
    1 = NeuN
    2 = Synaptophysin
    3 = PSD95

The script:
1. Loads each .ims file using the same BioImage scene as the NeuN segmentation.
2. Loads the existing NeuN label mask: <image_stem>_mask_3d.tif.
3. Creates a 3D shell around each NeuN object.
4. Detects Synaptophysin and PSD95 puncta independently.
5. Counts puncta in the shell of each NeuN-positive cell.
6. Matches Synaptophysin and PSD95 puncta one-to-one in 3D to estimate
   putative colocalized pre-/postsynaptic pairs.
7. Saves CSV results, label volumes, and a QC maximum-projection image showing:
      - segmented NeuN boundaries
      - positive Synaptophysin puncta
      - positive PSD95 puncta
      - matched Synaptophysin–PSD95 pairs

Install:
    pip install numpy pandas scipy scikit-image tifffile matplotlib bioio bioio-ome-tiff bioio-czi bioio-lif

Run:
    Edit SETTINGS below and run from the IDE/editor.
"""

from __future__ import annotations

from pathlib import Path
from typing import Dict, List, Tuple
import warnings

import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import tifffile
from bioio import BioImage
from scipy.ndimage import distance_transform_edt
from scipy.optimize import linear_sum_assignment
from skimage import exposure, filters, measure, morphology, segmentation


