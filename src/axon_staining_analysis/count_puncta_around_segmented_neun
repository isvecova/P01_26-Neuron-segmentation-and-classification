# SETTINGS
# ============================================================

# Folder containing the original .ims files.
INPUT_ROOT = Path(r"D:\OneDrive - IEM\000_inbox\260604_Kralova_python_troubleshooting\cellpose + far-red channel\data")

# Folder containing masks made by the NeuN segmentation script.
# The same relative subfolder structure is expected.
MASK_ROOT = Path(r"L:\Algernon\530\Sarah\segmentation_output_pseudo3d_260611")

# Output folder for puncta analysis.
OUTPUT_ROOT = Path(r"L:\Algernon\530\Sarah\puncta_analysis_260713")

# Must match the scene used in the segmentation script.
SCENE_INDEX = 2

# Channel indices.
DAPI_CHANNEL = 0
NEUN_CHANNEL = 1
SYNAPTOPHYSIN_CHANNEL = 2
PSD95_CHANNEL = 3

# Skip filenames containing this string.
SKIP_NAME_TOKEN = "Overview"

# Radius of the analyzed 3D shell outside each NeuN mask.
# A punctum is assigned to a neuron when its centroid lies in this shell.
SHELL_INNER_UM = 0.0
SHELL_OUTER_UM = 5.0

# Puncta preprocessing.
BACKGROUND_SIGMA_UM = 0.8
SMOOTH_SIGMA_UM = 0.15

# Puncta thresholds.
# 1.0 = Otsu threshold after background subtraction.
# Increase to be stricter; decrease to detect dimmer puncta.
SYNAPTOPHYSIN_THRESHOLD_MULTIPLIER = 1.0
PSD95_THRESHOLD_MULTIPLIER = 1.0

# Allowed connected-component volume.
# These values MUST be visually validated on QC images.
MIN_PUNCTUM_VOLUME_UM3 = 0.003
MAX_PUNCTUM_VOLUME_UM3 = 1.0

# Maximum 3D center-to-center separation for a Synaptophysin–PSD95 pair.
COLOCALIZATION_MAX_DISTANCE_UM = 0.5

# Remove puncta touching image borders.
REMOVE_BORDER_PUNCTA = False

# Save full 3D label stacks.
SAVE_LABEL_VOLUMES = True

# QC projection settings.
QC_DPI = 200
QC_MARKER_SIZE = 12


